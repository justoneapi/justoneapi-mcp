# Local Worker development only. Never paste real key material into this tracked example.
JUSTONEAPI_OAUTH_MODE=off
JUSTONEAPI_OAUTH_WORKER_ACTIVE_KID=replace-with-active-kid
JUSTONEAPI_OAUTH_WORKER_PRIVATE_JWKS='{"keys":[{"kty":"RSA","kid":"replace-with-active-kid","use":"sig","alg":"RS256","n":"replace","e":"AQAB","d":"replace","p":"replace","q":"replace","dp":"replace","dq":"replace","qi":"replace"}]}'
JUSTONEAPI_OAUTH_INTROSPECTION_CACHE_TTL_MS=60000
JUSTONEAPI_OAUTH_INTROSPECTION_CACHE_MAX_ENTRIES=2048
JUSTONEAPI_OAUTH_AS_TIMEOUT_MS=5000
JUSTONEAPI_MCP_ALLOWED_ORIGINS=*
